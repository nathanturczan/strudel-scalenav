{
  "name": "strudel-scalenav",
  "version": "0.6.0",
  "description": "Connect Strudel live-coding patterns to Scale Navigator ensembles. Sign in, join a live room, and sample the host's current scale, chord, and BPM as Strudel signals.",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "exports": {
    ".": "./index.js",
    "./scales": "./scales.js",
    "./chords": "./chords.js",
    "./resolver": "./resolver.js",
    "./visual": "./visual.js"
  },
  "files": [
    "index.js",
    "resolver.js",
    "scales.js",
    "chords.js",
    "visual.js",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "strudel",
    "tidalcycles",
    "livecoding",
    "live-coding",
    "algorave",
    "music",
    "harmony",
    "scale-navigator",
    "firebase",
    "ensemble"
  ],
  "author": "Nathan Turczan <nathanturczan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathanturczan/strudel-scalenav.git"
  },
  "bugs": {
    "url": "https://github.com/nathanturczan/strudel-scalenav/issues"
  },
  "homepage": "https://github.com/nathanturczan/strudel-scalenav#readme",
  "dependencies": {
    "firebase": "^10.13.0"
  },
  "peerDependenciesMeta": {
    "@strudel/core": {
      "optional": true
    }
  },
  "scripts": {
    "build": "esbuild index.js --bundle --format=esm --outfile=dist/strudel-scalenav.js --minify"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
